# This working directory holds the corpus, the model checkpoints and the run
# logs alongside the code. Only the code and the evaluation sets are tracked,
# so the rule is deny-by-default and everything published is listed by hand.
/*
!/.gitignore
!/LICENSE
!/README.md
!/solution.md
!/doc/
!/benchmark/
!/training/

# benchmark: code, config and docs
__pycache__/
*.pyc
# what the browser view leaves behind: the config it replaced on save
benchmark/config.json.bak

# benchmark data: evaluation sets only. The training split and the track 1
# chunk file are derived from copyrighted source documents and are rebuilt
# locally with build_all.py.
!/ground_truth
/ground_truth/*
!/ground_truth/holdout.json
!/ground_truth/track2_sft.jsonl
!/ground_truth/track3_vlm.jsonl
!/ground_truth/probe_trained.jsonl
!/ground_truth/uc1_safety_qa.jsonl
!/ground_truth/uc2_spec_threshold.jsonl
!/ground_truth/uc3_cross_image.jsonl
!/ground_truth/uc4_faithfulness.jsonl
!/ground_truth/uc5_incident.jsonl
!/ground_truth/uc6_verdict.jsonl
!/ground_truth/uc7_requirement.jsonl
!/ground_truth/uc6_verdict_v2.jsonl
!/ground_truth/volatility_validation.json
# runs/ holds scoring output, not the benchmark. Baseline numbers live in
# README.md and benchmark/CHANGELOG.md.

# the current answer key, built against the corpus regenerated with generator
# v0.5.2. Published the same way as /ground_truth/: the mined item sets and the
# holdout record, which hold questions, answers and citations. Everything else
# stays local -- train/ and track1_dapt.jsonl carry source text, and runs/,
# export/ and the reports are regenerated by the modules.
!/ground_truth_v052
/ground_truth_v052/*
!/ground_truth_v052/holdout.json
!/ground_truth_v052/probe_trained.jsonl
!/ground_truth_v052/track2_sft.jsonl
!/ground_truth_v052/track3_vlm.jsonl
!/ground_truth_v052/uc1_safety_qa.jsonl
!/ground_truth_v052/uc2_spec_threshold.jsonl
!/ground_truth_v052/uc3_cross_image.jsonl
!/ground_truth_v052/uc4_faithfulness.jsonl
!/ground_truth_v052/uc5_incident.jsonl
!/ground_truth_v052/uc6_verdict.jsonl
!/ground_truth_v052/uc6_verdict_v2.jsonl
!/ground_truth_v052/uc7_requirement.jsonl

# training: scripts only. Checkpoints, adapters and logs stay local.
training/out/
training/*.log
training/RESTART.md

# one-off re-baseline script, superseded by run_uc_baseline.sh
benchmark/run_uc_rebase.sh

# internal working notes, kept out of the repo
benchmark/CHANGELOG.md
benchmark/STANDARDS_REVIEW.md
